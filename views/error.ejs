<% layout("/layouts/boilerplate") %>
<!-- I have created this page using Claude  -->
  <style>
    :root {
      --navy:      #0b0e23;
      --navy-mid:  #0f1535;
      --navy-soft: #141a3a;
      --blue:      #2563eb;
      --blue-glow: #3b82f6;
      --accent:    #60a5fa;
      --white:     #ffffff;
      --muted:     #94a3b8;
      --star:      #e2e8f0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Nunito', sans-serif;
      background: var(--navy);
      color: var(--white);
      overflow: hidden;
    }

    /* ── Stars canvas ─────────────────────────────────────────── */
    #stars-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ── Page layout ──────────────────────────────────────────── */
    .page {
      position: relative;
      z-index: 1;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
      overflow: hidden;
    }

    /* ── Ghost 404 behind everything ─────────────────────────── */
    .ghost-404 {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: clamp(180px, 30vw, 340px);
      font-weight: 900;
      color: transparent;
      -webkit-text-stroke: 2px rgba(37, 99, 235, 0.13);
      letter-spacing: -10px;
      line-height: 1;
      user-select: none;
      pointer-events: none;
      white-space: nowrap;
      animation: ghostPulse 6s ease-in-out infinite;
    }

    @keyframes ghostPulse {
      0%, 100% { -webkit-text-stroke: 2px rgba(37,99,235,0.13); }
      50%       { -webkit-text-stroke: 2px rgba(96,165,250,0.22); }
    }

    /* ── Astronaut SVG wrapper ───────────────────────────────── */
    .astronaut-wrap {
      position: relative;
      z-index: 2;
      margin-bottom: 32px;
      animation: float 5s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(-3deg); }
      25%       { transform: translateY(-18px) rotate(2deg); }
      75%       { transform: translateY(8px) rotate(-5deg); }
    }

    /* Astronaut built entirely in SVG */
    .astronaut-svg {
      width: clamp(120px, 18vw, 190px);
      height: auto;
      filter: drop-shadow(0 0 24px rgba(96,165,250,0.35));
    }

    /* Visor glare shimmer */
    .visor-glare {
      animation: glare 4s ease-in-out infinite;
      transform-origin: center;
    }

    @keyframes glare {
      0%, 80%, 100% { opacity: 0.7; }
      40%            { opacity: 1; }
    }

    /* Tether cable */
    .tether {
      animation: tetherWave 3s ease-in-out infinite;
      transform-origin: top center;
    }

    @keyframes tetherWave {
      0%, 100% { d: path("M 100 10 Q 120 40 100 70 Q 80 100 105 130"); }
      50%       { d: path("M 100 10 Q 80 40 100 70 Q 120 100 95 130"); }
    }

    /* ── Content ──────────────────────────────────────────────── */
    .content {
      position: relative;
      z-index: 2;
      animation: fadeUp 0.8s 0.3s cubic-bezier(.22,1,.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .error-code {
      font-size: clamp(13px, 1.5vw, 15px);
      font-weight: 700;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .error-code::before,
    .error-code::after {
      content: '';
      width: 32px;
      height: 1px;
      background: var(--accent);
      opacity: 0.5;
    }

    .error-title {
      font-size: clamp(24px, 4vw, 38px);
      font-weight: 800;
      color: var(--white);
      letter-spacing: -0.5px;
      line-height: 1.2;
      margin-bottom: 14px;
    }

    .error-desc {
      font-size: clamp(14px, 1.6vw, 16px);
      font-weight: 400;
      color: var(--muted);
      max-width: 380px;
      line-height: 1.7;
      margin: 0 auto 36px;
    }

    /* ── Buttons ──────────────────────────────────────────────── */
    .btn-wrap {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-home {
      font-family: 'Nunito', sans-serif;
      font-size: 14px;
      font-weight: 700;
      padding: 13px 30px;
      border-radius: 50px;
      background: var(--blue);
      color: var(--white);
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all .2s;
      box-shadow: 0 0 0 0 rgba(37,99,235,0.5);
      animation: btnGlow 3s ease-in-out infinite;
    }

    @keyframes btnGlow {
      0%, 100% { box-shadow: 0 4px 20px rgba(37,99,235,0.4); }
      50%       { box-shadow: 0 4px 36px rgba(96,165,250,0.6); }
    }

    .btn-home:hover {
      background: #1d4ed8;
      transform: translateY(-2px);
      color: var(--white);
    }

    .btn-home:active { transform: translateY(0); }

    .btn-support {
      font-family: 'Nunito', sans-serif;
      font-size: 14px;
      font-weight: 700;
      padding: 12px 28px;
      border-radius: 50px;
      background: transparent;
      color: var(--accent);
      border: 1.5px solid rgba(96,165,250,0.35);
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all .2s;
    }

    .btn-support:hover {
      background: rgba(96,165,250,0.08);
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* ── Floating debris ──────────────────────────────────────── */
    .debris {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
    }

    .debris-1 {
      width: 8px; height: 8px;
      background: rgba(96,165,250,0.3);
      top: 22%; left: 15%;
      animation: orbit1 14s linear infinite;
    }

    .debris-2 {
      width: 5px; height: 5px;
      background: rgba(255,255,255,0.2);
      top: 65%; left: 20%;
      animation: orbit2 18s linear infinite;
    }

    .debris-3 {
      width: 10px; height: 10px;
      background: rgba(37,99,235,0.4);
      top: 30%; right: 18%;
      animation: orbit3 11s linear infinite;
      border-radius: 3px;
      transform: rotate(20deg);
    }

    .debris-4 {
      width: 4px; height: 4px;
      background: rgba(96,165,250,0.5);
      top: 70%; right: 22%;
      animation: orbit1 22s linear infinite reverse;
    }

    .debris-5 {
      width: 7px; height: 7px;
      background: rgba(255,255,255,0.1);
      top: 15%; right: 40%;
      animation: orbit2 16s linear infinite reverse;
      border-radius: 2px;
    }

    .debris-6 {
      width: 12px; height: 5px;
      background: rgba(37,99,235,0.25);
      top: 80%; left: 45%;
      border-radius: 3px;
      animation: orbit3 20s linear infinite;
    }

    @keyframes orbit1 {
      0%   { transform: translate(0,0) rotate(0deg); }
      25%  { transform: translate(30px, -20px) rotate(90deg); }
      50%  { transform: translate(60px, 10px) rotate(180deg); }
      75%  { transform: translate(20px, 30px) rotate(270deg); }
      100% { transform: translate(0,0) rotate(360deg); }
    }

    @keyframes orbit2 {
      0%   { transform: translate(0,0) rotate(0deg); }
      33%  { transform: translate(-40px, -30px) rotate(120deg); }
      66%  { transform: translate(20px, -50px) rotate(240deg); }
      100% { transform: translate(0,0) rotate(360deg); }
    }

    @keyframes orbit3 {
      0%   { transform: translate(0,0) rotate(0deg); }
      50%  { transform: translate(-25px, 40px) rotate(180deg); }
      100% { transform: translate(0,0) rotate(360deg); }
    }

    /* ── Responsive ───────────────────────────────────────────── */
    @media (max-width: 480px) {
      .ghost-404 { letter-spacing: -6px; }
      .astronaut-wrap { margin-bottom: 20px; }
    }
  </style>


  <!-- Animated star field -->
  <canvas id="stars-canvas"></canvas>

  <div class="page">

    <!-- Ghost 404 in background -->
    <div class="ghost-404">404</div>

    <!-- Floating debris particles -->
    <div class="debris debris-1"></div>
    <div class="debris debris-2"></div>
    <div class="debris debris-3"></div>
    <div class="debris debris-4"></div>
    <div class="debris debris-5"></div>
    <div class="debris debris-6"></div>

    <!-- Astronaut illustration (pure SVG) -->
    <div class="astronaut-wrap">
      <svg class="astronaut-svg" viewBox="0 0 200 240" fill="none" xmlns="http://www.w3.org/2000/svg">

        <!-- Tether cable -->
        <path class="tether" d="M 100 10 Q 120 40 100 70 Q 80 100 105 130"
              stroke="rgba(96,165,250,0.5)" stroke-width="2.5" stroke-dasharray="5 4"
              fill="none" stroke-linecap="round"/>

        <!-- Suit body -->
        <ellipse cx="100" cy="155" rx="44" ry="52" fill="#dbeafe"/>
        <ellipse cx="100" cy="155" rx="44" ry="52" fill="url(#bodyGrad)"/>

        <!-- Chest detail panel -->
        <rect x="80" y="135" width="40" height="30" rx="8" fill="#2563eb" opacity="0.9"/>
        <rect x="85" y="141" width="10" height="6" rx="2" fill="#60a5fa"/>
        <rect x="99" y="141" width="10" height="6" rx="2" fill="#34d399"/>
        <circle cx="89" cy="155" r="3" fill="#f87171"/>
        <circle cx="100" cy="155" r="3" fill="#fbbf24"/>
        <circle cx="111" cy="155" r="3" fill="#60a5fa"/>

        <!-- Left arm -->
        <ellipse cx="52" cy="162" rx="13" ry="28" fill="#bfdbfe" transform="rotate(15 52 162)"/>
        <!-- Left glove -->
        <ellipse cx="45" cy="188" rx="10" ry="8" fill="#93c5fd" transform="rotate(15 45 188)"/>

        <!-- Right arm -->
        <ellipse cx="148" cy="162" rx="13" ry="28" fill="#bfdbfe" transform="rotate(-15 148 162)"/>
        <!-- Right glove -->
        <ellipse cx="155" cy="188" rx="10" ry="8" fill="#93c5fd" transform="rotate(-15 155 188)"/>

        <!-- Legs -->
        <rect x="72" y="200" width="22" height="30" rx="10" fill="#93c5fd"/>
        <rect x="106" y="200" width="22" height="30" rx="10" fill="#93c5fd"/>
        <!-- Boots -->
        <ellipse cx="83" cy="232" rx="14" ry="7" fill="#60a5fa"/>
        <ellipse cx="117" cy="232" rx="14" ry="7" fill="#60a5fa"/>

        <!-- Neck ring -->
        <rect x="84" y="106" width="32" height="10" rx="5" fill="#93c5fd"/>

        <!-- Helmet outer -->
        <circle cx="100" cy="90" r="42" fill="#1e3a5f"/>
        <circle cx="100" cy="90" r="42" fill="url(#helmetGrad)"/>

        <!-- Visor -->
        <ellipse cx="100" cy="90" rx="28" ry="26" fill="url(#visorGrad)"/>

        <!-- Visor glare -->
        <ellipse class="visor-glare" cx="90" cy="80" rx="9" ry="6"
                 fill="rgba(255,255,255,0.18)" transform="rotate(-20 90 80)"/>
        <ellipse class="visor-glare" cx="113" cy="86" rx="5" ry="3"
                 fill="rgba(255,255,255,0.1)" transform="rotate(-20 113 86)"/>

        <!-- Helmet detail ring -->
        <circle cx="100" cy="90" r="36" stroke="rgba(255,255,255,0.12)" stroke-width="2" fill="none"/>

        <!-- Antenna -->
        <line x1="116" y1="52" x2="130" y2="34" stroke="#93c5fd" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="132" cy="32" r="5" fill="#60a5fa"/>
        <circle cx="132" cy="32" r="3" fill="white" opacity="0.8">
          <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite"/>
        </circle>

        <!-- Backpack / jetpack -->
        <rect x="60" y="128" width="14" height="24" rx="6" fill="#1e40af"/>
        <rect x="126" y="128" width="14" height="24" rx="6" fill="#1e40af"/>

        <!-- Jetpack thrusters (tiny flames) -->
        <ellipse cx="67" cy="156" rx="4" ry="6" fill="#fbbf24" opacity="0.7">
          <animate attributeName="ry" values="6;4;7;5;6" dur="0.4s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.7;0.4;0.8;0.5;0.7" dur="0.4s" repeatCount="indefinite"/>
        </ellipse>
        <ellipse cx="133" cy="156" rx="4" ry="6" fill="#fbbf24" opacity="0.7">
          <animate attributeName="ry" values="5;7;4;6;5" dur="0.45s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0.8;0.4;0.7;0.5" dur="0.45s" repeatCount="indefinite"/>
        </ellipse>

        <!-- Gradients -->
        <defs>
          <radialGradient id="helmetGrad" cx="40%" cy="35%">
            <stop offset="0%" stop-color="#2563eb" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#0b0e23" stop-opacity="0.4"/>
          </radialGradient>
          <linearGradient id="visorGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#1d4ed8"/>
            <stop offset="50%" stop-color="#0f172a"/>
            <stop offset="100%" stop-color="#1e3a5f"/>
          </linearGradient>
          <linearGradient id="bodyGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="white" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="rgba(96,165,250,0)" stop-opacity="0"/>
          </linearGradient>
        </defs>

      </svg>
    </div>

    <!-- Text content -->
    <div class="content">
      <div class="error-code">Error <%= err.statusCode %></div>
      <h1 class="error-title"><%= err.message %></h1>
      <p class="error-desc">
        <%= err.cause %>
      </p>
      <div class="btn-wrap">
        <a href="/home" class="btn-home">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Return Home
        </a>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // ── Star field ────────────────────────────────────────────
    const canvas = document.getElementById('stars-canvas');
    const ctx    = canvas.getContext('2d');
    let stars    = [];
    let W, H;

    function resize() {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    }

    function createStars(count) {
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x:       Math.random() * W,
          y:       Math.random() * H,
          r:       Math.random() * 1.6 + 0.3,
          alpha:   Math.random(),
          delta:   (Math.random() * 0.008 + 0.002) * (Math.random() < 0.5 ? 1 : -1),
          twinkle: Math.random() < 0.3,
        });
      }
    }

    function drawStars() {
      ctx.clearRect(0, 0, W, H);
      for (const s of stars) {
        if (s.twinkle) {
          s.alpha += s.delta;
          if (s.alpha > 1 || s.alpha < 0.1) s.delta *= -1;
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(226,232,240,${Math.min(1, Math.max(0.1, s.alpha))})`;
        ctx.fill();
      }
      requestAnimationFrame(drawStars);
    }

    resize();
    createStars(220);
    drawStars();
    window.addEventListener('resize', () => { resize(); createStars(220); });

    // ── Parallax on mouse move ────────────────────────────────
    document.addEventListener('mousemove', (e) => {
      const cx = W / 2, cy = H / 2;
      const dx = (e.clientX - cx) / cx;
      const dy = (e.clientY - cy) / cy;

      const astro = document.querySelector('.astronaut-wrap');
      astro.style.transform = `translateY(${dy * -12}px) translateX(${dx * -8}px) rotate(${dx * -4}deg)`;

      const ghost = document.querySelector('.ghost-404');
      ghost.style.transform = `translate(calc(-50% + ${dx * 14}px), calc(-50% + ${dy * 8}px))`;
    });
  </script>

