<% layout("/layouts/boilerplate") %>

<!-- Navbar -->
<%- include("layouts/navbar.ejs") %>

<!-- MAIN LAYOUT -->
<div class="container-fluid">
  <div class="row dashboard-container">

    <!-- Sidebar -->
    <%- include("layouts/sidebar") %>

    <!-- MAIN -->
    <main class="col-lg-7 col-md-7 col-12 ">
      <div class="container-fluid">

        <div class="add-buttons mt-2">
          <span>MY PRIORITY TICKETS (<%= user.count %>)</span>
        </div>

        <br />

        <div id="tickets-container"></div>

        <div id="pagination" class="d-flex justify-content-center mt-4"></div>

      </div>
    </main>

    <!-- RIGHT PANEL -->
    <div class="ai-bar col-lg-3 col-md-4 d-none d-md-block p-3 ">

      <!-- QUICK CREATE -->
      <div class="quickCreate container p-4 shadow mt-2 me-5 rounded-4 bg-white">
        
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="fa-solid fa-plus text-primary"></i>
          <span class="fs-5 text-primary"><b>Quick Create</b></span>
        </div>

        <form method="post" action="/helpdesk/dashboard">
          <input class="form-control" name="title" placeholder="Enter a title" required />
          <br />
          <input class="form-control" name="category" placeholder="Category" required />
          <br />
          <textarea class="form-control" name="description" placeholder="Description"></textarea>
          <br />
          <button class="btn btn-primary w-100">Create Ticket</button>
        </form>

      </div>
      <div class="container mt-3 me-4">
        <iframe 
          src="/Chatbot/helpdeskChatbot.html"
          style="width: 100%; height: 450px; border: none; border-radius: 16px;">
        </iframe>
      </div>

    </div>

  </div>
</div>

<script>
function getPriorityDotClass(priority) {
  const p = (priority || "").toLowerCase();
  if (p === "high")   return "dot-high";
  if (p === "medium") return "dot-medium";
  return "dot-low";
}

function getPriorityBadgeClass(priority) {
  const p = (priority || "").toLowerCase();
  if (p === "high")   return "badge-high";
  if (p === "medium") return "badge-medium";
  return "badge-low";
}

function formatDate(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

async function deleteTicket(event, id) {
  event.stopPropagation(); // prevent card click
  if (!confirm("Delete this ticket?")) return;

  await fetch(`/api/tickets/${id}/edit`, { method: "DELETE" });
  loadTickets(); // reload after delete
}

function renderTicketCard(t) {
  const priority   = t.priority || "low";
  const dotClass   = getPriorityDotClass(priority);
  const badgeClass = getPriorityBadgeClass(priority);
  const idStr      = t._id ? String(t._id).slice(-5).toUpperCase() : "00000";
  const dueDate    = t.dueDate ? formatDate(t.dueDate) : "";
  const category   = t.category || "";

  return `
    <div class="ticket-card" style="cursor:pointer;" onclick="window.location='/helpdesk/ticket/${t._id}'">
      <div class="ticket-aside">
        <div class="ticket-aside-dot ${dotClass}"></div>
        <div class="ticket-aside-num">${idStr}</div>
      </div>

      <div class="ticket-main">
        <div class="ticket-top">
          <div class="ticket-title">${t.title || "Untitled"}</div>
          <div class="ticket-desc">${t.description || ""}</div>
        </div>
        <div class="ticket-tags">
          ${category ? `<span class="ticket-tag">${category}</span>` : ""}
          ${t.status  ? `<span class="ticket-tag">${t.status}</span>` : ""}
        </div>
      </div>

      <div class="ticket-right">
        <span class="ticket-priority-badge ${badgeClass}">${priority}</span>
        <div class="ticket-right-bottom">
          ${dueDate ? `
          <div class="ticket-due">
            <svg viewBox="0 0 12 12" fill="none">
              <circle cx="6" cy="6" r="4.5" stroke="#7a8db5" stroke-width="1.2"/>
              <path d="M6 3.5V6.5l1.5 1" stroke="#7a8db5" stroke-width="1.2"/>
            </svg>
            ${dueDate}
          </div>` : ""}
          <div class="ticket-status">
            <div class="status-dot"></div>
            <span class="status-label">Open</span>
          </div>
        </div>

        <button
          onclick="deleteTicket(event, '${t._id}')"
          style="background:none;border:none;cursor:pointer;padding:4px;margin-top:6px;"
          title="Delete ticket"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#e53e3e" viewBox="0 0 16 16">
            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
          </svg>
        </button>

      </div>
    </div>
  `;
}

async function loadTickets(page = 1) {
  const res = await fetch(`/api/tickets/dashboard?page=${page}`);
  const data = await res.json();

  const container = document.getElementById("tickets-container");
  container.innerHTML = data.tickets.length
    ? data.tickets.map(renderTicketCard).join("")
    : `<p style="color:#7a8db5;font-size:13px;padding:1rem 0;">No tickets found.</p>`;

  const p = document.getElementById("pagination");
  p.innerHTML = "";

  const prev = document.createElement("button");
  prev.textContent = "← Prev";
  prev.className = "btn btn-light btn-sm me-1";
  prev.disabled = page === 1;
  prev.onclick = () => loadTickets(page - 1);
  p.appendChild(prev);

  for (let i = 1; i <= data.totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    btn.className = `btn btn-sm me-1 ${i === page ? "btn-primary" : "btn-light"}`;
    btn.onclick = () => loadTickets(i);
    p.appendChild(btn);
  }

  const next = document.createElement("button");
  next.textContent = "Next →";
  next.className = "btn btn-light btn-sm ms-1";
  next.disabled = page === data.totalPages;
  next.onclick = () => loadTickets(page + 1);
  p.appendChild(next);
}

window.onload = () => loadTickets(1);
</script>
