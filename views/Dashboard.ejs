<% layout("/layouts/boilerplate") %>

<style>
  .quickCreate {
    width: 90%;
  }
</style>

<!-- Navbar -->
<nav class="d-flex align-items-center gap-3 px-3 w-100">
  <a class="navbar-brand d-flex align-items-center" href="/home">
    <img src="/logo/logo.png" width="40" height="40" class="rounded-circle" />
    <b class="ms-2">Agentic AI</b>
  </a>

  <div class="list-items d-none d-lg-flex align-items-center">
    <span class="fw-bold fs-5 ms-4">Active Queue</span>
    <div class="online rounded-4 p-1 ms-3">
      <b>ONLINE & RECEIVING</b>
    </div>
  </div>

  <div class="search ms-auto">
    <form class="d-none d-sm-flex" style="max-width: 300px">
      <input class="form-control" type="search" placeholder="Quick Search" />
    </form>
  </div>

  <div class="card border-0 rounded-4 p-2 ms-3">
    <div class="d-flex align-items-center">
      <div class="fs-6 me-2 d-none d-md-block">
        <h6 class="mb-0 fw-semibold"><%= user.username %></h6>
        <small class="text-muted">Project Manager</small>
      </div>
      <img src="/images/photo2.png" class="rounded-circle" width="45" height="45" />
    </div>
  </div>
</nav>

<!-- MAIN LAYOUT -->
<div class="container-fluid">
  <div class="row dashboard-container">

    <!-- Sidebar -->
    <%- include("layouts/sidebar") %>

    <!-- MAIN -->
    <main class="col-lg-7 col-md-7 col-12">
      <div class="container-fluid">

        <div class="add-buttons mt-2">
          <span>MY PRIORITY TICKETS (<%= user.count %>)</span>
        </div>

        <br />

        <div id="tickets-container"></div>

        <div id="pagination" class="d-flex justify-content-center mt-4"></div>

      </div>
    </main>

    <!-- RIGHT PANEL -->
    <div class="ai-bar col-lg-3 col-md-4 d-none d-md-block p-0">
      <div class="quickCreate container p-4 shadow mt-2 me-5 rounded-4 bg-white">
        
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="fa-solid fa-plus text-primary"></i>
          <span class="fs-5 text-primary"><b>Quick Create</b></span>
        </div>

        <form method="post" action="/helpdesk/dashboard">
          <input class="form-control" name="title" placeholder="Enter a title" required />
          <br />
          <input class="form-control" name="category" placeholder="Category" required />
          <br />
          <textarea class="form-control" name="description" placeholder="Description"></textarea>
          <br />
          <button class="btn btn-primary w-100">Create Ticket</button>
        </form>

      </div>
    </div>

  </div>
</div>

<!-- CHATBOT -->
<iframe src="/Chatbot/helpdeskChatbot.html"
  style="position: fixed; bottom: 20px; right: 20px; width: 380px; height: 600px; border: none;">
</iframe>

<!-- SCRIPT -->
<script>
async function loadTickets(page = 1) {
  const res = await fetch(`/api/dashboard?page=${page}`);
  const data = await res.json();

  document.getElementById("tickets-container").innerHTML =
    data.tickets.map(t => `
      <div class="card p-3 mb-2">
        <b>${t.title}</b>
        <p>${t.description}</p>
      </div>
    `).join("");

  const p = document.getElementById("pagination");
  p.innerHTML = "";

  const prev = document.createElement("button");
  prev.textContent = "← Prev";
  prev.className = "btn btn-light btn-sm me-1";
  prev.disabled = page === 1;
  prev.onclick = () => loadTickets(page - 1);
  p.appendChild(prev);

  for (let i = 1; i <= data.totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    btn.className = `btn btn-sm me-1 ${i === page ? "btn-primary" : "btn-light"}`;
    btn.onclick = () => loadTickets(i);
    p.appendChild(btn);
  }

  const next = document.createElement("button");
  next.textContent = "Next →";
  next.className = "btn btn-light btn-sm ms-1";
  next.disabled = page === data.totalPages;
  next.onclick = () => loadTickets(page + 1);
  p.appendChild(next);
}

window.onload = () => loadTickets(1);
</script>