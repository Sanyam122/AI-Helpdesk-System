<!-- Changing badge color -->
<script>
  function updateBadges() {
    const badges = document.querySelectorAll(".priorityBadge");

    badges.forEach((badge) => {
      const priority = badge.dataset.priority.toLowerCase();

      badge.classList.remove(
        "text-bg-danger",
        "text-bg-warning",
        "text-bg-success",
      );

      if (priority === "high") {
        badge.classList.add("text-bg-danger"); // red
      } else if (priority === "medium") {
        badge.classList.add("text-bg-warning"); // yellow
      } else {
        badge.classList.add("text-bg-success"); // green
      }
    });
  }
  window.onload = updateBadges;
</script>
