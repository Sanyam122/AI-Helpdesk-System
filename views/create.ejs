<% layout("/layouts/boilerplate") %>

<style>
  .create {
    min-height: 100vh;
    background-image: url("../gradientBackground/1092567.png");
    background: #0ab6f5;
    background: -webkit-linear-gradient(90deg, rgba(10, 182, 245, 1) 9%, rgba(87, 121, 199, 1) 100%, rgba(237, 221, 83, 1) 100%);
    background: -moz-linear-gradient(90deg, rgba(10, 182, 245, 1) 9%, rgba(87, 121, 199, 1) 100%, rgba(237, 221, 83, 1) 100%);
    background: linear-gradient(90deg, rgba(10, 182, 245, 1) 9%, rgba(87, 121, 199, 1) 100%, rgba(237, 221, 83, 1) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient(startColorstr="#0AB6F5", endColorstr="#EDDD53", GradientType=1);

  }

  form {
    background-color: white;
  }

  .ticket {
    border-radius: 10px;
  }


</style>

<body class="create p-3 p-md-4">
  <!-------------------- Creating ticket section  --------------->

  <div class="container-fluid">
    <div class="row justify-content-center align-items-center">
      <!-- Ticket Card -->
      <div class="ticket col-12 col-sm-10 col-md-8 col-lg-6 p-4">
        <!-- Heading -->
        <div class="ticket-heading mb-4">
          <span class="d-flex align-items-center gap-2 fs-4 fs-md-3">
           
            <b style="color: white;"> ⚡Raise a Ticket</b>
          </span>

          <p class="text-muted mt-2" style="color: white !important;">
            Our AI will automatically route your ticket to the right department
            for faster solutions.
          </p>
        </div>

        <!-------------- create ticket form --------------->
        <form
          method="post"
          class="form p-3 p-md-4 rounded-4 row gap-2 shadow "
          action="/helpdesk/dashboard"
          nonvalidate
        >
          <!-- title -->
          <label for="title" class="form-label">
            <b>Ticket Title</b>
          </label>

          <input
            type="text"
            placeholder="Describe what's happening"
            name="title"
            class="form-control"
            required
            title="Enter a valid Title please."
          />
          <br />
          <!-- Issue category -->
          <label for="" class="form-label"><b>Issue Category</b></label>
          <input
            type="text"
            placeholder="Select Department"
            class="form-control"
            name="category"
            required
            title="Enter a valid category please."
          />
          <!-- Priority -->
          <label for="inputGroupSelect01" class="mt-3"><b>Priority</b></label>
          <div class="input-group">
            <label class="input-group-text" for="inputGroupSelect01"
              >Priority</label
            >
            <select class="form-select" id="inputGroupSelect01" name="priority">
              <option selected>Choose...</option>
              <option value="Normal">Normal</option>
              <option value="Medium">Medium</option>
              <option value="High">High</option>
            </select>
          </div>

          <!-- Description -->
          <label for="description" class="form-label mt-3"
            ><b>Detailed Description</b></label
          >
          <textarea
            name="description"
            id=""
            placeholder="Please provide as much detail as possible."
            class="form-control"
            required
            title="Enter a valid description please."
          ></textarea>

          <br />
          <hr />
          <div
            class="Sumbit-button d-md-flex justify-content-between align-items-center"
          >
            <p class="col-md-6 text-muted">
              By submitting, you agree to our corporate data policies. AI
              analysis will be performed on ticket contents.
            </p>

            <button class="btn btn-primary btn-lg me-md-6 ms-4">
              Submit Ticket
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                class="m-1"
              >
                <path fill="#ffffff" d="m0 0l20 10L0 20V0zm0 8v4l10-2L0 8z" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
