<% layout("/layouts/boilerplate") %>

<style>
  .shadow-2 {
    box-shadow: rgba(0,0,0,0.16) 0px 3px 6px,
                rgba(0,0,0,0.23) 0px 3px 6px;
  }

  main {
    background: #f9f9f9;
    padding: 20px;
    height: 91.5vh
  }

  .progressCard {
    height: 110px;
  }

  .progressCardImg {
    background-color: #cde4fb;
  }

  .ticket-id {
    color: #2563eb;
    font-weight: 600;
  }

  .table tbody tr:hover {
    background: #f8fafc;
    cursor: pointer;
  }

  .table {
    margin-bottom: 0;
  }
</style>

<!-- NAVBAR -->
<%- include("layouts/navbar.ejs") %>
<!-- MAIN LAYOUT -->
<div class="container-fluid ">
  <div class="row">

    <!-- SIDEBAR (DEFAULT BOOTSTRAP) -->
     <%- include("layouts/sidebar") %>

    <!-- MAIN CONTENT -->
    <main class="col-lg-10 col-md-11 col-12 px-4 h-100">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
        <div>
          <h1 class="fw-bolder">My Ticket List</h1>
          <p class="text-muted">
            Manage and track your active support requests
          </p>
        </div>

        <button class="btn btn-primary shadow-2 mt-2 mt-md-0 d-sm-none">
          Create New Ticket
        </button>
      </div>

      <!-- CARDS -->
      <div class="row g-3  mt-2">

        <div class="col-md-4">
          <div class="progressCard shadow-2 d-flex align-items-center rounded-4 p-3">
            <div class="progressCardImg p-3 rounded-4 me-3 d-none d-sm-block">
              <i class="fa-solid fa-ticket text-primary fs-3"></i>
            </div>
            <div>
              <small class="text-muted"><b>OPEN TICKETS</b></small>
              <p class="fs-4 fw-bold"><%= user.count %></p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="progressCard shadow-2 d-flex align-items-center rounded-4 p-3">
            <div class="progressCardImg p-3 rounded-4 me-3 d-none d-sm-block" style="background:#fed7aa">
              <i class="fa-solid fa-spinner text-warning fs-3"></i>
            </div>
            <div>
              <small class="text-muted"><b>IN PROGRESS</b></small>
              <p class="fs-4 fw-bold"><%= Math.max(user.count,0) %></p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="progressCard shadow-2 d-flex align-items-center rounded-4 p-3">
            <div class="progressCardImg p-3 rounded-4 me-3 d-none d-sm-block">
              <i class="fa-solid fa-circle-check text-success fs-3"></i>
            </div>
            <div>
              <small class="text-muted"><b>RESOLVED</b></small>
              <p class="fs-4 fw-bold">48</p>
            </div>
          </div>
        </div>

      </div>

      <!-- TABLE -->
      <div class="container my-4">
        <div class="table-responsive shadow rounded-4">
          <table class="table align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th>Ticket ID</th>
                <th class="d-none d-md-table-cell">Category</th>
                <th>Status</th>
                <th class="d-none d-md-table-cell">Priority</th>
                <th>Created Date</th>
                <th></th>
              </tr>
            </thead>

            <tbody>
              <% for(let ticket of tickets){ %>
              <tr>

                <td class="ticket-id">
                  #TKT-<%= ticket._id.toString().slice(-6).toUpperCase() %>
                </td>

                <td class="d-none d-md-table-cell">
                  <%= ticket.category %>
                </td>

                <td>
                  <span class="badge bg-primary"><%= ticket.status %></span>
                </td>

                <td class="d-none d-md-table-cell text-danger">
                  <%= ticket.priority %>
                </td>

                <td>
                  <%= ticket.createdAt.toLocaleDateString() %>
                </td>

                <td>
                  <i class="fa-solid fa-ellipsis-vertical"></i>
                </td>

              </tr>
              <% } %>
            </tbody>

          </table>
        </div>
      </div>

    </main>
  </div>
</div>
<%- include("layouts/mobileNav.ejs") %>