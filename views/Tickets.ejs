<% layout("/layouts/boilerplate") %>
<style>
  .shadow-2 {
    box-shadow:
      rgba(0, 0, 0, 0.16) 0px 3px 6px,
      rgba(0, 0, 0, 0.23) 0px 3px 6px;
  }
  .ticket_body {
    min-width: 100vw;
  }

  .shadow {
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .ticket-id {
    color: #2563eb;
    font-weight: 600;
  }

  /* status badges */

  .status-open {
    background: #e0ecff;
    color: #2563eb;
  }

  .status-progress {
    background: #fdeacc;
    color: #d97706;
  }

  .status-resolved {
    background: #d1fae5;
    color: #059669;
  }

  /* priority */

  .priority-high {
    color: #ef4444;
    font-weight: 500;
  }

  .priority-medium {
    color: #f97316;
    font-weight: 500;
  }

  .priority-low {
    color: #6b7280;
    font-weight: 500;
  }

  /* row hover */

  .table tbody tr:hover {
    background: #f8fafc;
    cursor: pointer;
  }

  .progressCard {
    width: 30% !important;
    height: 110px;
  }
  .progressCardImg {
    background-color: #cde4fb;
  }
</style>
<body class="ticket_body">
  <nav class="d-flex align-items-center gap-3 px-3 ticket_page mx-1">
    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center p-1" href="/home">
      <img src="/logo/logo.png" width="40" height="40" class="rounded-circle" />
      <b class="ms-2">Agentic AI</b>
    </a>

    <!-- Middle Items -->
    <div class="list-items d-none d-lg-flex align-items-center p-2">
      <span class="fw-bold fs-5 ms-2">Active Queue</span>

      <div class="online rounded-4 p-1 ms-3">
        <b>ONLINE & RECEIVING</b>
      </div>
    </div>

    <!-- Search -->
    <div class="search ms-auto ticket_search">
      <form class="d-none d-sm-flex" style="max-width: 300px">
        <input class="form-control" type="search" placeholder="Quick Search" />
      </form>
    </div>

    <!-- Profile -->
    <div class="card border-0 rounded-4 p-2 ms-3">
      <div class="d-flex align-items-center">
        <div class="fs-6 me-2 d-none d-md-block">
          <h6 class="mb-0 fw-semibold">Sanyam Jain</h6>
          <small class="text-muted">Project Manager</small>
        </div>

        <img
          src="images/photo2.png"
          class="rounded-circle"
          width="45"
          height="45"
        />
      </div>
    </div>
  </nav>
  <!-- Main -->
  <div class="ms-3 mt-3">
    <a href="/helpdesk/dashboard"
      ><button class="btn btn-md-lg btn-primary"><b>Back</b></button></a
    >
  </div>
  <div
    class="myTicketList p-3 d-flex justify-content-between align-items-center mt-3"
  >
    <div class="heading mt-2 d-none d-sm-block">
      <h1 class="fw-bolder">My Ticket List</h1>
      <p class="text-muted">
        Manage and track your active support requests across the enterprise
      </p>
    </div>
    <div class="createButton">
      <button class="btn btn-lg btn-primary shadow-2 d-none d-sm-block">
        Create New Ticket
      </button>
    </div>
  </div>
  <!-- Progress and Other cards -->
  <div
    class="progressCards p-3 d-flex justify-content-between align-items-center gap-3 mx-md-3"
  >
    <!-- stat 1  -->
    <div
      class="progressCard shadow-2 d-flex align-items-center rounded-4 gap-1 overflow-y-hidden"
    >
      <div
        class="progressCardImg p-3 w-auto ms-2 h-auto rounded-4 d-none d-sm-block"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="50"
          height="50"
          viewBox="0 0 24 24"
        >
          <path
            fill="#137fec"
            d="M6 4v4h12V4h2.007c.548 0 .993.445.993.993v16.014a.994.994 0 0 1-.993.993H3.993A.993.993 0 0 1 3 21.007V4.993C3 4.445 3.445 4 3.993 4H6Zm3 13H7v2h2v-2Zm0-3H7v2h2v-2Zm0-3H7v2h2v-2Zm7-9v4H8V2h8Z"
          />
        </svg>
      </div>
      <div class="progressCardText">
        <small class="text-muted text-center"><b>OPEN TICKETS</b></small>
        <br />
        <p class="fs-1 fw-bolder text-center"><%= user.count %></p>
      </div>
    </div>

    <!-- stat 2 -->
    <div
      class="progressCard shadow-2 d-flex align-items-center rounded-4 gap-1 overflow-y-hidden"
    >
      <div
        class="progressCardImg p-3 w-auto ms-2 h-auto rounded-4 d-none d-sm-block"
        style="background-color: #fed7aa"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="50"
          height="50"
          viewBox="0 0 20 20"
        >
          <path
            fill="#EA580C"
            d="M10 3v2a5 5 0 0 0-3.54 8.54l-1.41 1.41A7 7 0 0 1 10 3zm4.95 2.05A7 7 0 0 1 10 17v-2a5 5 0 0 0 3.54-8.54l1.41-1.41zM10 20l-4-4l4-4v8zm0-12V0l4 4l-4 4z"
          />
        </svg>
      </div>
      <div class="progressCardText">
        <small class="text-muted text-center"><b>IN PROGRESS</b></small>
        <br />
        <p class="fs-1 fw-bolder text-center">
          <%= Math.max(user.count , 0 )%>
        </p>
      </div>
    </div>

    <!-- stat-3 -->
    <div
      class="progressCard shadow-2 d-flex align-items-center rounded-4 gap-1"
    >
      <div
        class="progressCardImg p-3 w-auto ms-2 h-auto rounded-4 d-none d-sm-block"
      >
        <i
          class="fa-solid fa-circle-check"
          style="color: rgb(99, 230, 190); font-size: xxx-large"
        ></i>
      </div>
      <div class="progressCardText">
        <small class="text-muted text-center"><b>RESOLVED</b></small>
        <br />
        <p class="fs-1 fw-bolder text-center">48</p>
      </div>
    </div>
  </div>
  <!-- TicketLists -->
  <div class="container my-4">
    <div class="card border-0">
      <div class="table-responsive shadow">
        <table class="table align-middle mb-0 shadow rounded-4">
          <thead class="table-light">
            <tr>
              <th>Ticket ID</th>

              <th class="d-none d-md-table-cell">Category</th>

              <th>Status</th>

              <th class="d-none d-md-table-cell">Priority</th>

              <th>Created Date</th>

              <th></th>
            </tr>
          </thead>

          <tbody>
            <% for(let ticket of tickets){ %>
            <tr>
              <td class="ticket-id">
                #TKT-<%= ticket._id.toString().slice(-6).toUpperCase() %>
              </td>

              <td class="d-none d-md-table-cell">
                <i class="bi bi-laptop me-2 text-secondary"></i>
                <%= ticket.category %>
              </td>

              <td>
                <span class="badge status-open"><%= ticket.status %></span>
              </td>

              <td class="priority-high d-none d-md-table-cell">
                <%= ticket.priority %>
              </td>

              <td>
                <%= ticket.createdAt.toLocaleDateString() %>
              </td>

              <td>
                <i class="bi bi-three-dots-vertical"></i>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
