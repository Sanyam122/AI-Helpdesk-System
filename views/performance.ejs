<% layout("/layouts/boilerplate") %>

<style>
  .dashboard-container {
    min-height: calc(100vh - 70px);
  }

  .sidebar {
    min-height: 100vh;
  }

  .chart-container {
    position: relative;
    width: 100%;
    height: 320px;
  }
  .performance-sidebar {
    height: 100vh !important;
  }
</style>

<body class="position-relative h-100">
  <!------------------ Navbar --------------->

  <nav class="container-fluid d-flex align-items-center gap-3 px-3 w-100">
    <a class="navbar-brand d-flex align-items-center" href="/home">
      <img src="/logo/logo.png" width="40" height="40" class="rounded-circle" />
      <b class="ms-2">Agentic AI</b>
    </a>

    <div class="list-items d-none d-lg-flex align-items-center">
      <span class="fw-bold fs-5 ms-4">Active Queue</span>

      <div class="online rounded-4 p-1 ms-3">
        <b>ONLINE & RECEIVING</b>
      </div>
    </div>

    <div class="search ms-auto">
      <form class="d-none d-sm-flex" style="max-width: 300px">
        <input class="form-control" type="search" placeholder="Quick Search" />
      </form>
    </div>

    <div class="card border-0 rounded-4 p-2 ms-3">
      <div class="d-flex align-items-center">
        <div class="fs-6 me-2 d-none d-md-block">
          <h6 class="mb-0 fw-semibold">Sanyam Jain</h6>
          <small class="text-muted">Project Manager</small>
        </div>

        <img
          src="images/photo2.png"
          class="rounded-circle"
          width="45"
          height="45"
        />
      </div>
    </div>
  </nav>

