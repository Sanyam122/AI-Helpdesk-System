<% layout("/layouts/boilerplate") %>

<style>
  .dashboard-container {
    min-height: calc(100vh - 70px);
  }

  .chart-container {
    position: relative;
    width: 100%;
    height: 320px;
  }

  .mainPerformance {
    background: #f9fafb;
    padding: 20px;
  }
</style>

<!------------------ Navbar --------------->
<%- include("layouts/navbar.ejs") %>

<!---------------- Layout ---------------->
<div class="container-fluid">
  <div class="row dashboard-container">

    <!---------------- Sidebar ------------------>
    <%- include("layouts/sidebar") %>

    <!---------------- Main Content ------------------>
    <div class="col-lg-10 col-md-11 col-12 mainPerformance">

      <!-- Stats -->
      <div class="row g-4 mt-2">

        <!-- Active Tickets -->
        <div class="col-md-6 col-lg-3 d-none d-md-block">
          <div class="card shadow rounded-4 border-0 p-3">
            <svg xmlns="http://www.w3.org/2000/svg" height="45" width="45" viewBox="0 0 640 640">
              <path fill="#137fec" d="M96 128C60.7 128 32 156.7 32 192L32 256C32 264.8 39.4 271.7 47.7 274.6C66.5 281.1 80 299 80 320C80 341 66.5 358.9 47.7 365.4C39.4 368.3 32 375.2 32 384L32 448C32 483.3 60.7 512 96 512L544 512C579.3 512 608 483.3 608 448L608 384C608 375.2 600.6 368.3 592.3 365.4C573.5 358.9 560 341 560 320C560 299 573.5 281.1 592.3 274.6C600.6 271.7 608 264.8 608 256L608 192C608 156.7 579.3 128 544 128L96 128zM448 400L448 240L192 240L192 400L448 400zM144 224C144 206.3 158.3 192 176 192L464 192C481.7 192 496 206.3 496 224L496 416C496 433.7 481.7 448 464 448L176 448C158.3 448 144 433.7 144 416L144 224z"/>
            </svg>
            <h6 class="text-muted mt-2">Active Tickets</h6>
            <p class="fs-4 fw-bold"><%= activeTickets %></p>
          </div>
        </div>

        <!-- Avg. Resolution -->
        <div class="col-md-6 col-lg-3 d-none d-md-block">
          <div class="card shadow rounded-4 border-0 p-3">
            <svg xmlns="http://www.w3.org/2000/svg" height="45" width="45" viewBox="0 0 640 640">
              <path fill="#ea580c" d="M466.6 114.2C461.2 115.9 455.3 116 450.4 113.3C444.6 110.1 438.6 107.1 432.6 104.4C422.2 99.7 418.9 86.1 428.5 79.8C443.5 69.9 461.5 64.1 480.8 64.1C533.4 64.1 576 106.7 576 159.3C576 172.5 573.3 185.1 568.4 196.6C563.9 207.1 550 206.4 543.5 197C539.7 191.5 535.7 186.2 531.5 181C528 176.6 527 170.8 527.7 165.2C527.9 163.3 528.1 161.3 528.1 159.3C528.1 133.2 506.9 112.1 480.9 112.1C476 112.1 471.2 112.9 466.7 114.3zM96.5 196.9C90 206.3 76 207 71.6 196.5C66.7 185 64 172.4 64 159.2C64 106.6 106.6 64 159.2 64C178.5 64 196.5 69.8 211.5 79.7C221.1 86 217.8 99.6 207.4 104.3C201.3 107.1 195.4 110 189.6 113.2C184.7 115.9 178.7 115.8 173.4 114.1C168.9 112.7 164.2 111.9 159.2 111.9C133.1 111.9 112 133.1 112 159.1C112 161.1 112.1 163.1 112.4 165C113.1 170.6 112.1 176.4 108.6 180.8C104.4 186 100.4 191.3 96.6 196.8zM496 352C496 254.8 417.2 176 320 176C222.8 176 144 254.8 144 352C144 449.2 222.8 528 320 528C417.2 528 496 449.2 496 352zM460.5 526.5C422.1 557.4 373.2 576 320 576C266.8 576 217.9 557.4 179.5 526.5L137 569C127.6 578.4 112.4 578.4 103.1 569C93.8 559.6 93.7 544.4 103.1 535.1L145.6 492.6C114.6 454.1 96 405.2 96 352C96 228.3 196.3 128 320 128C443.7 128 544 228.3 544 352C544 405.2 525.4 454.1 494.5 492.5L537 535C546.4 544.4 546.4 559.6 537 568.9C527.6 578.2 512.4 578.3 503.1 568.9L460.6 526.4zM344 248L344 342.1L385 383.1C394.4 392.5 394.4 407.7 385 417C375.6 426.3 360.4 426.4 351.1 417L303.1 369C298.6 364.5 296.1 358.4 296.1 352L296.1 248C296.1 234.7 306.8 224 320.1 224C333.4 224 344.1 234.7 344.1 248z"/>
            </svg>
            <h6 class="text-muted mt-2">Avg. Resolution</h6>
            
            <p class="fs-4 fw-bold">2h 15min</p>
          </div>
        </div>

        <!-- AI Deflection  -->
        <div class="col-md-6 col-lg-3 d-none d-md-block">
          <div class="card shadow rounded-4 border-0 p-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 28 28">
              <path fill="#6d28d9" d="M10.06 18.701a1.628 1.628 0 0 0 2.43-.676l.77-2.34a3.823 3.823 0 0 1 2.416-2.418l2.238-.727a1.61 1.61 0 0 0 .786-.595a1.62 1.62 0 0 0-.849-2.489l-2.215-.72a3.82 3.82 0 0 1-2.42-2.414l-.727-2.237a1.622 1.622 0 0 0-.594-.785a1.655 1.655 0 0 0-1.879 0a1.627 1.627 0 0 0-.6.8L8.68 6.365a3.817 3.817 0 0 1-2.359 2.37l-2.24.726a1.626 1.626 0 0 0 .02 3.073l2.216.72a3.856 3.856 0 0 1 1.816 1.286c.266.343.471.728.606 1.14l.728 2.234c.112.318.32.593.595.787Zm9.744 6.08a1.2 1.2 0 0 0 .696.22a1.2 1.2 0 0 0 .692-.217a1.21 1.21 0 0 0 .446-.6l.372-1.143a1.609 1.609 0 0 1 1.017-1.02l1.166-.378A1.213 1.213 0 0 0 25 20.505a1.2 1.2 0 0 0-.844-1.146l-1.144-.37a1.609 1.609 0 0 1-1.02-1.018l-.38-1.163a1.2 1.2 0 0 0-2.274.016l-.374 1.146a1.61 1.61 0 0 1-.993 1.017l-1.166.378a1.213 1.213 0 0 0-.807 1.139a1.2 1.2 0 0 0 .823 1.138l1.144.372a1.606 1.606 0 0 1 1.02 1.023l.379 1.163a1.2 1.2 0 0 0 .44.582Z"/>
            </svg>
            <h6 class="text-muted mt-2">AI Deflection</h6>
            
            <p class="fs-4 fw-bold">64.2%</p>
          </div>
        </div>

        <!-- CSAT Score -->
        <div class="col-md-6 col-lg-3 d-none d-md-block">
          <div class="card shadow rounded-4 border-0 p-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 640 640">
              <path fill="rgb(99, 230, 190)" d="M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM229.4 385.9C249.8 413.9 282.8 432 320 432C357.2 432 390.2 413.9 410.6 385.9C418.4 375.2 433.4 372.8 444.1 380.6C454.8 388.4 457.2 403.4 449.4 414.1C420.3 454 373.2 480 320 480C266.8 480 219.7 454 190.6 414.1C182.8 403.4 185.2 388.4 195.9 380.6C206.6 372.8 221.6 375.2 229.4 385.9zM240 244C224.5 244 212 256.5 212 272L212 280C212 291 203 300 192 300C181 300 172 291 172 280L172 272C172 234.4 202.4 204 240 204C277.6 204 308 234.4 308 272L308 280C308 291 299 300 288 300C277 300 268 291 268 280L268 272C268 256.5 255.5 244 240 244zM372 272L372 280C372 291 363 300 352 300C341 300 332 291 332 280L332 272C332 234.4 362.4 204 400 204C437.6 204 468 234.4 468 272L468 280C468 291 459 300 448 300C437 300 428 291 428 280L428 272C428 256.5 415.5 244 400 244C384.5 244 372 256.5 372 272z"/>
            </svg>
            <h6 class="text-muted mt-2">CSAT Score</h6>
            <p class="fs-4 fw-bold">4.8/5.0</p>
          </div>
        </div>

      </div>

      <!---------- Chart ---------->
      <div class="card p-4 shadow rounded-4 w-100 mt-4 d-none d-md-block">
        <div class="chart-container">
          <canvas
             id="ticketChart"
             data-user-id="<%= user._id %>"
            aria-label="Tickets created in the last 7 days"
            role="img"
          ></canvas>
        </div>
        <div id="chartLoading" class="text-center text-muted py-2" style="display:none;">
          <small>Loading chart...</small>
        </div>
        <div id="chartError" class="text-center text-danger py-2" style="display:none;">
          <small>Failed to load chart data. Please refresh.</small>
        </div>
      </div>

      <!---------- Table ---------->
      <div class="w-100 mt-4 mb-5">
        <div class="table-responsive shadow rounded-4">
          <table class="table mb-0">
            <thead class="table-light">
              <tr>
                <th>Issue</th>
                <th>Department</th>
                <th>Handler</th>
              </tr>
            </thead>
            <tbody>
              <% for(let ticket of tickets || [] ){ %>
              <tr>
                <td><%= ticket.title %></td>
                <td><%= ticket.category %></td>
                <td><%= ticket.assignedTo ? '@' + ticket.assignedTo : 'Unassigned' %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include("layouts/mobileNav.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/Chart/chart.js"></script>