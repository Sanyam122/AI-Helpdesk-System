<% layout("/layouts/boilerplate") %>

<style>
  html,
  body {
    overflow-x: hidden;
  }
  .mycard {
    min-height: 18rem;
    max-width: 22rem;
    width: 100%;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
  }

  .icon {
    background-color: rgb(161, 212, 251);
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px;
  }

  .icon2 {
    background-color: rgba(0, 128, 0, 0.4);
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px;
  }

  .icon3 {
    background-color: rgb(255, 212, 59, 0.3);
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px;
  }

  .another-section {
    background-color: #001a2c;
  }

  .ready {
    color: white;
  }
  .feature-check > p {
    color: white;
    display: inline;
    opacity: 0.7;
  }

  .footer-logo {
    height: 2rem;
    width: 2rem;
  }
  .footer {
    min-height: 40vh;
    text-wrap: wrap;
  }
  .list > ul {
    padding: 0;
    list-style: none;
  }
  .bottompart > p {
    margin-right: auto;
  }
  .privacy > p {
    margin-right: 0.5rem;
  }
</style>

<!-- navbar -->
<nav class="container d-flex justify-content-between align-items-center py-3">
  <div class="d-flex align-items-center">
    <a href="/home" class="d-flex align-items-center text-decoration-none">
      <img src="/logo/logo.png" class="weblogo rounded-circle" />
      <b class="ms-2 mb-0 text-dark fs-md-3 fs-6">Agentic AI</b>
    </a>
  </div>

  <div class="d-none d-md-block">
    <a href="#features" class="me-3">Features</a>
    <a href="#solutions" class="me-3">Solutions</a>
    <a href="#contact">Contact</a>
  </div>

  <div class="d-flex justify-content-center">
    <a href="/login"><button class="btn btn-primary me-2">Login</button></a>
    <a href="/signin"><button class="btn btn-primary">Get Started</button></a>
  </div>
</nav>

<!-- Main Section -->
<div class="container py-5">
  <div class="row align-items-center">
    <!-- TEXT -->
    <div class="col-lg-6 col-12 text-center text-lg-start">
      <h1 class="fw-bold">
        Revolutionize <br />
        Corporate <br />
        Efficiency with <br />
        <span style="color: #137fec">AI-Driven</span><br />
        Support
      </h1>

      <p class="opacity-75 mt-3">
        Streamline workflows, reduced response times and empower the enterprise
        teams with automation that works 24/7.
      </p>

      <div
        class="mt-3 d-flex gap-2 flex-wrap justify-content-center justify-content-lg-start"
      >
        <button class="btn btn-primary">Start Free Trial</button>

        <button class="btn btn-outline-dark">
          <i class="fa-solid fa-circle-play me-1"></i>
          Watch Demo
        </button>
      </div>
    </div>

    <!-- Image -->
    <div class="col-lg-6 col-12 text-center mt-4 mt-lg-0">
      <img src="/images/image.png" class="img-fluid" />
    </div>
  </div>
</div>

<!-- SECTION 3 -->
<div class="container py-4" id="features">
  <h1>Engineered for Enterprise Excellence</h1>
  <p>
    Our AI powered platform provides the tools you need to manage complex
    corporate environment with ease and precision.
  </p>
</div>

<!-- cards -->
<div class="container">
  <div class="row g-4 justify-content-center">
    <!-- card 1 -->
    <div class="col-xl-4 col-md-6 col-12 d-flex justify-content-center">
      <div class="mycard rounded-4">
        <div class="icon rounded-4 m-4 p-4 d-inline-flex">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            viewBox="0 0 640 512"
          >
            <title>Robot SVG Icon</title>
            <path
              fill="#59c7f9"
              d="M320 0c17.7 0 32 14.3 32 32v64h120c39.8 0 72 32.2 72 72v272c0 39.8-32.2 72-72 72H168c-39.8 0-72-32.2-72-72V168c0-39.8 32.2-72 72-72h120V32c0-17.7 14.3-32 32-32M208 384c-8.8 0-16 7.2-16 16s7.2 16 16 16h32c8.8 0 16-7.2 16-16s-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16s7.2 16 16 16h32c8.8 0 16-7.2 16-16s-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16s7.2 16 16 16h32c8.8 0 16-7.2 16-16s-7.2-16-16-16zM264 256a40 40 0 1 0-80 0a40 40 0 1 0 80 0m152 40a40 40 0 1 0 0-80a40 40 0 1 0 0 80M48 224h16v192H48c-26.5 0-48-21.5-48-48v-96c0-26.5 21.5-48 48-48m544 0c26.5 0 48 21.5 48 48v96c0 26.5-21.5 48-48 48h-16V224z"
            />
          </svg>
        </div>
        <div class="m-3">
          <h4>AI Automations</h4>
          <p>
            Smart ticket routing and auto-resolutions to handle high-volume
            requests instantly without human intervention.
          </p>
        </div>
      </div>
    </div>

    <!-- card 2 -->
    <div class="col-xl-4 col-md-6 col-12 d-flex justify-content-center">
      <div class="mycard rounded-4">
        <div class="icon2 rounded-4 m-4 p-4 d-inline-flex">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            viewBox="0 0 16 16"
          >
            <title>Graph-up SVG Icon</title>
            <path
              fill="#008000"
              fill-rule="evenodd"
              d="M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61l4.15-5.073a.5.5 0 0 1 .704-.07"
            />
          </svg>
        </div>
        <div class="m-3">
          <h4>Real-Time Analytics</h4>
          <p>
            Gain deep visibility into team performance with live dashboards.
          </p>
        </div>
      </div>
    </div>

    <!-- card 3 -->
    <div class="col-xl-4 col-md-6 col-12 d-flex justify-content-center">
      <div class="mycard rounded-4">
        <div class="icon3 rounded-4 m-4 p-4 d-inline-flex">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            viewBox="0 0 16 16"
          >
            <title>Shield-fill SVG Icon</title>
            <path
              fill="#ffd43b"
              d="M5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453a7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625a11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43A63 63 0 0 1 5.072.56"
            />
          </svg>
        </div>
        <div class="m-3">
          <h4>Enterprise Security</h4>
          <p>
            Bank-grade compliance and end-to-end encryption for total safety.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid another-section py-5 mt-5">
  <div class="container text-center text-lg-center">
    <h1 class="fw-bold ready">Ready to transform support?</h1>

    <p class="text-white-50">
      Join over 500+ enterprises that trust Helpdesk AI to power their
      operations.
    </p>

    <div class="mt-3">
      <button type="button" class="btn btn-primary btn-lg m-1 m-md-2">
        Start Your Free Trial
      </button>
      <button type="button" class="btn btn-secondary btn-lg m-1 m-md-2">
        Schedule a demo
      </button>
    </div>
    <hr style="color: white" />
    <!-- feature checks -->
    <div class="mt-2 d-flex justify-content-evenly">
      <div class="feature-check">
        <i
          class="fa-solid fa-circle-check"
          style="color: rgb(99, 230, 190)"
        ></i>
        <p>No credit card required</p>
      </div>
      <div class="feature-check">
        <i
          class="fa-solid fa-circle-check"
          style="color: rgb(99, 230, 190)"
        ></i>
        <p>14-day free trial</p>
      </div>
      <!-- FIX 5: Corrected typo "SCO2 Compilant" → "SOC 2 Compliant" -->
      <div class="feature-check">
        <i
          class="fa-solid fa-circle-check"
          style="color: rgb(99, 230, 190)"
        ></i>
        <p>SOC 2 Compliant</p>
      </div>
    </div>
  </div>
</div>

<!-- footer -->
<footer class="container">
  <div class="footer row p-4">
    <div class="helpdesk-ai col-lg-3 col-md-3 p-3">
      <img src="/logo/logo.png" class="footer-logo" />
      <h6 class="d-inline">Agentic AI</h6>
      <br /><br />
      <p>
        The leading AI powered solution for high-growth enterprises worldwide.
      </p>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <title>Twitter-fill SVG Icon</title>
        <path
          fill="currentColor"
          d="M23.643 4.937c-.835.37-1.732.62-2.675.733a4.67 4.67 0 0 0 2.048-2.578a9.3 9.3 0 0 1-2.958 1.13a4.66 4.66 0 0 0-7.938 4.25a13.229 13.229 0 0 1-9.602-4.868c-.4.69-.63 1.49-.63 2.342A4.66 4.66 0 0 0 3.96 9.824a4.647 4.647 0 0 1-2.11-.583v.06a4.66 4.66 0 0 0 3.737 4.568a4.692 4.692 0 0 1-2.104.08a4.661 4.661 0 0 0 4.352 3.234a9.348 9.348 0 0 1-5.786 1.995a9.5 9.5 0 0 1-1.112-.065a13.175 13.175 0 0 0 7.14 2.093c8.57 0 13.255-7.098 13.255-13.254c0-.2-.005-.402-.014-.602a9.47 9.47 0 0 0 2.323-2.41z"
        />
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <title>Linkedin-v1-fill SVG Icon</title>
        <path
          fill="currentColor"
          fill-rule="evenodd"
          d="M1 2.838A1.838 1.838 0 0 1 2.838 1H21.16A1.837 1.837 0 0 1 23 2.838V21.16A1.838 1.838 0 0 1 21.161 23H2.838A1.838 1.838 0 0 1 1 21.161zm8.708 6.55h2.979v1.496c.43-.86 1.53-1.634 3.183-1.634c3.169 0 3.92 1.713 3.92 4.856v5.822h-3.207v-5.106c0-1.79-.43-2.8-1.522-2.8c-1.515 0-2.145 1.089-2.145 2.8v5.106H9.708zm-5.5 10.403h3.208V9.25H4.208zM7.875 5.812a2.063 2.063 0 1 1-4.125 0a2.063 2.063 0 0 1 4.125 0"
          clip-rule="evenodd"
        />
      </svg>
    </div>

    <!-- FIX 3 & 4: Replaced <ol> labels and bare <li> tags with proper <ul> list structure -->
    <div class="support col-lg-9 col-md-9 p-3 d-flex justify-content-evenly">
      <div class="list text-wrap">
        <b>PRODUCT</b>
        <ul>
          <li>Features</li>
          <li>Integration</li>
          <li>Pricing</li>
          <li>Roadmap</li>
        </ul>
      </div>
      <div class="list text-wrap">
        <b>SUPPORT</b>
        <ul>
          <li>Help Center</li>
          <li>Security</li>
          <li>Contact</li>
        </ul>
      </div>
    </div>

    <div class="col-12 mt-3 border-top pt-3">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <p class="mb-0">© 2026 Agentic AI. All rights reserved.</p>
        <div class="d-flex gap-4 flex-wrap">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Service</a>
          <a href="#">Cookie Settings</a>
        </div>
      </div>
    </div>
  </div>
</footer>
