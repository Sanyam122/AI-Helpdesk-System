<script>
   const approveNotification = require("../Controller/ticketController.js");
</script>

<style>
   .actionCenter{
    height: 92.2vh;
    width: 100% !important;
    margin: 0;
   }

   .time{
    opacity: 0.6;
   }
   
   #confirmation{
    top:50%;
    left: 50%;
    border: 1px solid black;
    
   }

</style>
<% layout("layouts/boilerplate") %>

<%- include("layouts/navbar.ejs") %>


<div class="container-fluid row d-flex actionCenter ">

 <!-- Sidebar -->
 <%- include("layouts/sidebar.ejs") %>

 <main class=" col-lg-7 col-md-7 col-12 flex-grow-1">
   <% for( let notification of notifications) { %>

    <div class="card p-3 m-4 rounded-4">
        <div class="card-title m-2"><span><b>DataBase Access Request</b></span></div>

        <div  class=" m-2 border-none rounded-4">Rahul Sharma requested access to your DataBase </div>
        <div class="m-2 fw-500"><%= notification.ticketId.title %></div>

        <div class="accessButtons mt-3 mx-2  gap-3">
           <button class="btn btn-primary" type="submit" onclick="approveNotification()">Approve</button>
           <button commandfor="confirmation" command="show-popover" class="btn btn-danger ">Deny</button>
        </div>
        
        <form method="get" action="/helpdesk/actionCenter" >
         <div  id="confirmation" popover class="position-relative rounded-4 p-3">
            <p>Are you sure do you want to deny ?</p>
            <button class="btn btn-danger mt-3" type="submit">OK</button>
         </div>
        </form>

    </div>
    <% } %>
 </main>
</div>