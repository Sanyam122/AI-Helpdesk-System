<style>
  .flash {
  position: fixed;
  top: 80px;
  right: 24px;
  z-index: 9999;
  padding: 14px 18px;
  min-width: 260px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 500;
  box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  animation: showFlash 0.25s ease, hideFlash 0.35s ease 5s forwards;
}

.flash-success {
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
}

.flash-error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}

.flash-info {
  background: #eff6ff;
  color: #1d4ed8;
  border: 1px solid #bfdbfe;
}

.flash-warning {
  background: #fffbeb;
  color: #b45309;
  border: 1px solid #fde68a;
}

@keyframes showFlash {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes hideFlash {
  to {
    opacity: 0;
    transform: translateX(24px);
    pointer-events: none;
  }
}
</style>
<nav class="d-flex align-items-center gap-3 px-3 w-100">
  <a class="navbar-brand d-flex align-items-center" href="/home">
    <img src="/logo/logo.png" class="weblogo rounded-circle" />
    <b class="ms-2">Agentic AI</b>
  </a>

  <div class="list-items d-none d-lg-flex align-items-center">
    <span class="fw-bold fs-5 ms-4">Active Queue</span>
    <div class="online rounded-4 p-1 ms-3">
      <b>ONLINE & RECEIVING</b>
    </div>
  </div>

  <div class="search ms-auto">
    <form class="d-none d-sm-flex" style="max-width: 300px">
      <input class="form-control" type="search" placeholder="Quick Search" />
    </form>
  </div>

  <div class="card border-0 rounded-4 p-2 ms-3">
    <div class="d-flex align-items-center">
      <div class="fs-6 me-2 d-none d-md-block">
        <h6 class="mb-0 fw-semibold"><%= user.username %></h6>
        <small class="text-muted">Project Manager</small>
      </div>
      <img src="<%= user.avatar %>" class="rounded-circle" width="45" height="45" />
    </div>
  </div>
  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %>">
      <%= flash.message %>
    </div>
  <% } %>
</nav>