<style>
  .profile-card:hover{
    border: none !important;
    box-shadow: rgba(6, 24, 44, 0.4) 0px 0px 0px 2px, rgba(6, 24, 44, 0.65) 0px 4px 6px -1px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset;
    cursor: pointer;
  }
  .profileButton{
    background-color: transparent;
    border: none;
  }
  .profileDetails:popover-open{
    border: 0.5px solid black !important;
    position: fixed; /* or absolute if centering within a positioned ancestor */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20rem;
    height: 20rem;
    border-radius: 25px;
  }

</style>
<nav class="d-flex align-items-center gap-3 px-3 w-100">
  <a class="navbar-brand d-flex align-items-center" href="/home">
    <img src="/logo/logo.png" class="weblogo rounded-circle" />
    <b class="ms-2">Agentic AI</b>
  </a>

  <div class="list-items d-none d-lg-flex align-items-center">
    <span class="fw-bold fs-5 ms-4">Active Queue</span>
    <div class="online rounded-4 p-1 ms-3">
      <b>ONLINE & RECEIVING</b>
    </div>
  </div>

  <div class="search ms-auto">
    <form class="d-none d-sm-flex" style="max-width: 300px">
      <input class="form-control" type="search" placeholder="Quick Search" />
    </form>
  </div>

  
  <div class="profile-card border-0 card rounded-5 py-2 px-3 ms-3">
    <button class="profileButton" popovertarget="profileDetails" popovertargetaction="toggle" >
    <div class="d-flex align-items-center">
      <div class="fs-6 me-2 d-none d-md-block">
        <h6 class="mb-0 fw-semibold"><%= user.username %></h6>
        <small class="text-muted">Project Manager</small>
      </div>
      <% if (!user.avatar) { %>
        <i class="fa-solid fa-user" style="font-size: 35px; margin-left: 10px;"></i>
      <% } else { %>
      <img src="<%= user.avatar %>" class="rounded-circle" width="45" height="45" />
      <% } %>
    </div>
  </button>
  </div>
 <div class="profileDetails" id="profileDetails" popover>
  <div>
    <form action="" class="p-3 m-2">
      <label for="username" class="form-label">Username</label>
      <input type="text" class="form-control" disabled id="username" value="<%= user.username %>">
      <br>
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" disabled class="form-control" value="<%= user.email %>">
      <br>
      <label for="role" class="form-label">Role</label>
      <input type="text" class="form-control" value="Project Manager" id="role" disabled>
    </form>
  </div>
 </div>


  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %> text-center">
      <%= flash.message %>
    </div>
  <% } %>
</nav>
