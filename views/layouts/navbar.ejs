
<nav class="d-flex align-items-center gap-3 px-3 w-100">
  <a class="navbar-brand d-flex align-items-center" href="/home">
    <img src="/logo/logo.png" class="weblogo rounded-circle" />
    <b class="ms-2">Agentic AI</b>
  </a>

  <div class="list-items d-none d-lg-flex align-items-center">
    <span class="fw-bold fs-5 ms-4">Active Queue</span>
    <div class="online rounded-4 p-1 ms-3">
      <b>ONLINE & RECEIVING</b>
    </div>
  </div>

  <div class="search ms-auto">
    <form class="d-none d-sm-flex" style="max-width: 300px">
      <input class="form-control" type="search" placeholder="Quick Search" />
    </form>
  </div>

  <div class="card border-0 rounded-4 p-2 ms-3">
    <div class="d-flex align-items-center">
      <div class="fs-6 me-2 d-none d-md-block">
        <h6 class="mb-0 fw-semibold"><%= user.username %></h6>
        <small class="text-muted">Project Manager</small>
      </div>
      <% if (!user.avatar) { %>
        <i class="fa-solid fa-user" style="font-size: 45px;"></i>
      <% } else { %>
      <img src="<%= user.avatar %>" class="rounded-circle" width="45" height="45" />
      <% } %>
    </div>
  </div>
  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %> text-center">
      <%= flash.message %>
    </div>
  <% } %>
</nav>
<style>
 .flash {
  position: fixed;
  top: calc(var(--nav-height, 72px) + 16px);
  left: 50%;
  transform: translateX(-50%) translateY(-22px);
  z-index: 9999;

  width: min(462px, calc(100vw - 32px));
  min-height: 58px;
  padding: 15px 20px;

  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.96)),
    linear-gradient(135deg, #ffffff, #dbeafe);

  border: 1px solid rgba(37, 99, 235, 0.16);

  color: #0f172a;
  font-size: 14.5px;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: -0.01em;

  box-shadow:
    0 24px 60px rgba(37, 99, 235, 0.20),
    0 8px 22px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);

  opacity: 0;
  pointer-events: none;
  overflow: hidden;

  animation: flashToast 5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* Soft premium glow */
.flash::after {
  content: "";
  position: absolute;
  top: -45%;
  right: -12%;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.28), transparent 68%);
  pointer-events: none;
}

/* Progress bar */
.flash::before {
  content: "";
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 8px;
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(90deg, #2563eb, #60a5fa, #bfdbfe);
  animation: flashProgress 5s linear forwards;
}

/* Success */
.flash-success {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.96)),
    linear-gradient(135deg, #ffffff, #dbeafe);
  border-color: rgba(37, 99, 235, 0.18);
  color: #0f172a;
}

/* Error */
.flash-error {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 241, 242, 0.96)),
    linear-gradient(135deg, #ffffff, #ffe4e6);
  border-color: rgba(225, 29, 72, 0.22);
  color: #881337;
}

.flash-error::before {
  background: linear-gradient(90deg, #e11d48, #fb7185, #fecdd3);
}

.flash-error::after {
  background: radial-gradient(circle, rgba(251, 113, 133, 0.26), transparent 68%);
}

/* Warning */
.flash-warning {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 251, 235, 0.96)),
    linear-gradient(135deg, #ffffff, #fef3c7);
  border-color: rgba(245, 158, 11, 0.24);
  color: #78350f;
}

.flash-warning::before {
  background: linear-gradient(90deg, #f59e0b, #fbbf24, #fde68a);
}

.flash-warning::after {
  background: radial-gradient(circle, rgba(251, 191, 36, 0.26), transparent 68%);
}

/* Info */
.flash-info {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.96)),
    linear-gradient(135deg, #ffffff, #dbeafe);
  border-color: rgba(37, 99, 235, 0.18);
  color: #0f172a;
}

@keyframes flashToast {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(-24px) scale(0.96);
    filter: blur(4px);
  }

  12% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
    filter: blur(0);
  }

  84% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
    filter: blur(0);
  }

  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-18px) scale(0.97);
    filter: blur(3px);
  }
}

@keyframes flashProgress {
  from {
    transform: scaleX(1);
    transform-origin: left;
  }

  to {
    transform: scaleX(0);
    transform-origin: left;
  }
}
</style>